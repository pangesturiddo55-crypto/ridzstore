local TELEPORT_POS = Vector3.new(-289.02, 234.19, 14244.04)
local isX2Active = false
local x2LoopCoroutine = nil
local isCollectCashActive = false
local collectCashCoroutine = nil

local function setAllZIndex(parent, z)
    if parent:IsA("GuiObject") then
        parent.ZIndex = z
    end
    for _, child in pairs(parent:GetChildren()) do
        setAllZIndex(child, z)
    end
end
setAllZIndex(mainFrame, 999999999)

local function teleport()
    local char = localPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = CFrame.new(TELEPORT_POS)
            teleportButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            task.wait(0.15)
            teleportButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        end
    end
end
teleportButton.MouseButton1Click:Connect(teleport)

local function getOffsetX()
    return tonumber(offsetXBox.Text) or 0
end
local function getOffsetY()
    return tonumber(offsetYBox.Text) or 0
end

local function claimX2Once()
    local gui = localPlayer:FindFirstChild("PlayerGui")
    if not gui then return end
    local popUp = gui:FindFirstChild("PopUp")
    if not popUp then return end
    local frame2x = popUp:FindFirstChild("2xButton")
    if not frame2x or not frame2x:IsA("Frame") or not frame2x.Visible then return end
    local imageLabel = frame2x:FindFirstChild("ImageLabel")
    if not imageLabel or not imageLabel.Visible then return end

    local done = false
    pcall(function()
        if imageLabel.MouseButton1Click then
            firesignal(imageLabel.MouseButton1Click)
            done = true
        end
    end)
    if not done then
        pcall(function()
            if imageLabel.Activated then
                firesignal(imageLabel.Activated)
                done = true
            end
        end)
    end
    if not done then
        local cd = imageLabel:FindFirstChildOfClass("ClickDetector")
        if cd then
            fireclickdetector(cd)
            done = true
        end
    end
    if not done then
        local center = imageLabel.AbsolutePosition + imageLabel.AbsoluteSize / 2
        local targetX = center.X + getOffsetX()
        local targetY = center.Y + getOffsetY()
        vim:SendMouseButtonEvent(targetX, targetY, 0, true, game, 0)
        task.wait(0.05)
        vim:SendMouseButtonEvent(targetX, targetY, 0, false, game, 0)
    end
end

local function x2Loop()
    while isX2Active do
        pcall(claimX2Once)
        task.wait(0.3)
    end
end

local function startX2()
    isX2Active = true
    x2LoopCoroutine = task.spawn(x2Loop)
    x2ClaimButton.Text = "X2 CLAIM: ON"
    x2ClaimButton.BackgroundColor3 = Color3.fromRGB(35, 150, 35)
end

local function stopX2()
    isX2Active = false
    if x2LoopCoroutine then
        pcall(task.cancel, x2LoopCoroutine)
        x2LoopCoroutine = nil
    end
    x2ClaimButton.Text = "X2 CLAIM: OFF"
    x2ClaimButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
end

x2ClaimButton.MouseButton1Click:Connect(function()
    if not isX2Active then startX2() else stopX2() end
end)

local function collectAllPodiums()
    local char = localPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local base = workspace:FindFirstChild("Base")
    if not base then return false end
    local targetBase = base:FindFirstChild("Base" .. selectedBase)
    if not targetBase then return false end
    local podiums = targetBase:FindFirstChild("Podiums")
    if not podiums then return false end

    for i = 1, 50 do
        if not isCollectCashActive then break end
        local podium = podiums:FindFirstChild("Podium" .. i)
        if podium then
            local cashClaim = podium:FindFirstChild("CashClaim")
            if cashClaim and cashClaim:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(hrp, cashClaim, 0)
                    task.wait(0.01)
                    firetouchinterest(hrp, cashClaim, 1)
                end)
            end
        end
        task.wait(0.02)
    end
    return true
end

local function collectCashLoop()
    while isCollectCashActive do
        collectAllPodiums()
        task.wait(1)
    end
end

local function startCollectCash()
    isCollectCashActive = true
    collectCashCoroutine = task.spawn(collectCashLoop)
    collectCashButton.Text = "Collect Cash: ON"
    collectCashButton.BackgroundColor3 = Color3.fromRGB(35, 150, 35)
end

local function stopCollectCash()
    isCollectCashActive = false
    if collectCashCoroutine then
        pcall(task.cancel, collectCashCoroutine)
        collectCashCoroutine = nil
    end
    collectCashButton.Text = "Collect Cash: OFF"
    collectCashButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
end

collectCashButton.MouseButton1Click:Connect(function()
    if not isCollectCashActive then startCollectCash() else stopCollectCash() end
end)

local dragging, dragInput, dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

local isMin = false
minimizeButton.MouseButton1Click:Connect(function()
    isMin = not isMin
    if isMin then
        contentFrame.Visible = false
        mainFrame.Size = UDim2.new(0, 220, 0, 30)
        minimizeButton.Text = "+"
        minimizeButton.BackgroundColor3 = Color3.fromRGB(35, 150, 35)
    else
        contentFrame.Visible = true
        mainFrame.Size = UDim2.new(0, 220, 0, 300)
        minimizeButton.Text = "-"
        minimizeButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end)

closeButton.MouseButton1Click:Connect(function()
    stopX2()
    stopCollectCash()
    BetaGui:Destroy()
end)

task.spawn(function()
    local vu = game:GetService("VirtualUser")
    Players.LocalPlayer.Idled:Connect(function()
        vu:CaptureController()
        vu:ClickButton2(Vector2.new(0, 0))
    end)
end)
